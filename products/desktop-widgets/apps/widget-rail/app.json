{
  "id": "widget-rail",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Desktop Widgets"
  },
  "summary": {
    "en": "System health and resource suggestions."
  },
  "icon": "view-grid-symbolic",
  "runtime": "binary",
  "entry": "bin/yuos-applet-widget-rail",
  "mcp": {
    "entry": "bin/yuos-applet-widget-rail",
    "transport": "stdio",
    "lifecycle": "lazy",
    "tools": [
      {
        "name": "widget-rail.system",
        "summary": {
          "en": "Read system resource telemetry from the OS service."
        },
        "args": [],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "resources"
              }
            },
            "why": {
              "en": "Observe system resource usage for the System Health card."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Read system resource telemetry."
            },
            "recovery": "not_applicable"
          }
        ]
      }
    ]
  },
  "operations": {
    "open": {
      "label": {
        "en": "Open the desktop widget rail"
      },
      "needs": [
        {
          "verb": "sys.observe",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "resources"
            }
          },
          "why": {
            "en": "Observe system resource usage for the System Health card."
          }
        }
      ],
      "effects": [
        {
          "kind": "execute",
          "label": {
            "en": "Open the desktop widget rail"
          },
          "recovery": "unknown"
        }
      ]
    }
  },
  "desktop": {
    "exec": "open",
    "needs": [
      {
        "verb": "sys.observe",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "resources"}},
        "why": {"en": "Observe system resource usage for the System Health card."}
      },
      {
        "verb": "ui.panel",
        "scope": {"kind": "fixed", "scope": {"kind": "wild"}},
        "why": {"en": "Display the widget panel in your authenticated desktop."}
      }
    ],
    "name": {
      "en": "Desktop Widgets"
    },
    "icon": "view-grid-symbolic",
    "categories": [
      "Utility"
    ],
    "single_instance": true,
    "panel_applet": true
  }
}
