{
  "manifest_version": 3,
  "name": "Yu Mail AI",
  "short_name": "yuos-mail-ai",
  "version": "0.2.0",
  "description": "AI helpers for Thunderbird: summarise, smart reply, smart compose, translate, triage, and chat with your mailbox. Bridged to the yu kernel via Native Messaging.",
  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "yu-mail-ai@yuos.io",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "menus",
    "notifications",
    "tabs",
    "messagesRead",
    "messagesModify",
    "messagesMove",
    "messagesTags",
    "messages.send",
    "messages.save",
    "messagesDelete",
    "accountsRead",
    "compose",
    "compose.save"
  ],

  "background": {
    "scripts": ["lib/native.js", "lib/mailbox.js", "background.js"]
  },

  "message_display_action": {
    "default_title": "__MSG_summarize_title__",
    "default_popup": "ui/summarize/summarize.html",
    "default_icon": {
      "16": "icons/agent.png",
      "32": "icons/agent.png"
    },
    "theme_icons": [
      { "light": "icons/agent-dark.png", "dark": "icons/agent.png", "size": 16 },
      { "light": "icons/agent-dark.png", "dark": "icons/agent.png", "size": 32 }
    ]
  },

  "compose_action": {
    "default_title": "__MSG_compose_title__",
    "default_popup": "ui/compose/composeAction.html",
    "default_icon": {
      "16": "icons/agent.png",
      "32": "icons/agent.png"
    },
    "theme_icons": [
      { "light": "icons/agent-dark.png", "dark": "icons/agent.png", "size": 16 },
      { "light": "icons/agent-dark.png", "dark": "icons/agent.png", "size": 32 }
    ]
  },

  "compose_scripts": [
    {
      "js": ["ui/compose/composeScript.js"]
    }
  ],

  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/agent.png",
    "32": "icons/agent.png",
    "48": "icons/agent.png",
    "96": "icons/agent.png"
  }
}
