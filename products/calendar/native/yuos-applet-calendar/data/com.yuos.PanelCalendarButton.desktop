[Desktop Entry]
Name=Calendar
Comment=View the calendar and local agenda
Type=Application
Exec=yuos-applet-calendar
Terminal=false
Categories=Utility;X-YuOS;
Keywords=Yu OS;Applet;Calendar;Schedule;
Icon=com.yuos.Calendar
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
